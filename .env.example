# URL pública del sitio (Vercel: dominio de producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Settings → API (solo Project URL, sin /rest/v1)
# Sin credenciales reales el catálogo usa mocks en /lib/mocks
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional — solo servidor (Settings → API → service_role). No exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# Admin interno: emails permitidos para /internal separados por coma
INTERNAL_ADMIN_EMAILS=dueno@dominio.com

# Setup base de datos (SQL Editor o Supabase CLI):
# 1. supabase/migrations/20250514120000_initial_schema.sql
# 2. supabase/migrations/20250515130000_inquiry_tables.sql
# 3. supabase/migrations/20250519140000_storage_and_site_content.sql
# 4. supabase/seed.sql  (o: npm run generate:seed)
#
# Storage buckets (products, categories, pizzellas, brand, site) se crean en la migración 3.
# Subidas admin requieren SUPABASE_SERVICE_ROLE_KEY.

# Regenerar tipos desde tu proyecto remoto (requiere Supabase CLI):
# npm run db:types
