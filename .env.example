# URL pública del sitio (Vercel: dominio de producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (proyecto → Settings → API)
# Sin estas variables el sitio usa mocks locales en /lib/mocks
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon

# Tras crear el proyecto:
# 1. Ejecutá supabase/migrations/20250514120000_initial_schema.sql
# 2. Ejecutá supabase/seed.sql (o: npm run generate:seed && pegá el SQL)
